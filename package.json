{
  "name": "shotchart.d3.ts",
  "version": "0.2.0",
  "description": "Framework-agnostic basketball shotchart primitives built on D3. Renders to any SVG element. Supports NBA and college court dimensions.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles/shotchart.css",
    "./package.json": "./package.json"
  },
  "sideEffects": ["**/*.css"],
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write .",
    "ci:lint": "biome check .",
    "ci:publint": "publint",
    "ci:attw": "attw --pack",
    "release:patch": "pnpm version patch && git push --follow-tags",
    "release:minor": "pnpm version minor && git push --follow-tags",
    "release:major": "pnpm version major && git push --follow-tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelmirandi/shotchart.d3.ts.git"
  },
  "keywords": [
    "shotchart",
    "basketball",
    "d3",
    "svg",
    "typescript",
    "visualization",
    "nba",
    "ncaa"
  ],
  "author": "Michael Mirandi",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/michaelmirandi/shotchart.d3.ts/issues"
  },
  "homepage": "https://github.com/michaelmirandi/shotchart.d3.ts#readme",
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^1.9.4",
    "@types/d3-array": "^3.2.1",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-selection": "^3.0.10",
    "@types/d3-shape": "^3.1.6",
    "publint": "^0.3.21",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
