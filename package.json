{
  "name": "shotchart.d3.ts",
  "version": "0.2.0",
  "description": "Framework-agnostic basketball shotchart primitives built on D3. Renders to any SVG element. Supports NBA and college court dimensions.",
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "rollup -c --bundleConfigAsCjs",
    "lint": "npx prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelmirandi/shotchart.d3.ts.git"
  },
  "keywords": [
    "shotchart",
    "basketball",
    "d3",
    "svg",
    "typescript",
    "visualization",
    "nba"
  ],
  "author": "Michael Mirandi",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/michaelmirandi/shotchart.d3.ts/issues"
  },
  "homepage": "https://github.com/michaelmirandi/shotchart.d3.ts#readme",
  "dependencies": {
    "d3": "^7.3.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^22.0.2",
    "@rollup/plugin-node-resolve": "^13.3.0",
    "@rollup/plugin-typescript": "^8.3.4",
    "@types/d3": "^7.4.0",
    "rollup": "^3.23.0",
    "rollup-plugin-dts": "^4.2.2",
    "rollup-plugin-ignore": "^1.0.10",
    "rollup-plugin-import-css": "^3.0.3",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-terser": "^7.0.2",
    "typescript": "^5.4.0"
  }
}
